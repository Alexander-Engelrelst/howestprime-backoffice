@using Howestprime.Backoffice.ViewModels
@using Howestprime.Backoffice.ViewModels.Planning

<div class="calendar-grid">
    @foreach (int day in Enumerable.Range(1, DaysInMonth))
    {
        DateOnly date = new DateOnly(Year, Month, day);
        DayCellViewModel dayViewModel = DayCellViewModels[day];

        <DayCell Date="@date"
                 ViewModel="@dayViewModel"
                 LegendViewModel="@LegendViewModel"
                 OnDateClick="@OnDateClick"/>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<int, DayCellViewModel> DayCellViewModels { get; set; }

    [Parameter, EditorRequired]
    public LegendViewModel LegendViewModel { get; set; } = new();

    [Parameter, EditorRequired]
    public int Year { get; set; }

    [Parameter, EditorRequired]
    public int Month { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<DateOnly> OnDateClick { get; set; }

    [Parameter, EditorRequired]
    public int DaysInMonth { get; set; }
}
