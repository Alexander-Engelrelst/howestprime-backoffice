@using Howestprime.Backoffice.ViewModels
@using Howestprime.Backoffice.ViewModels.Planning
<div class="month-nav-container">
    <CalendarLegend/>
    <CalendarNav NavigatorViewModel="@NavigatorViewModel" OnMonthChange="@OnMonthChange"/>
    <div style="width: 100px;"></div> <!-- Empty div for balanced spacing -->
</div>

@code {
    [Parameter, EditorRequired]
    public NavigatorViewModel NavigatorViewModel { get; set; }
    
    [Parameter, EditorRequired]
    public EventCallback<int> OnMonthChange { get; set; }
}