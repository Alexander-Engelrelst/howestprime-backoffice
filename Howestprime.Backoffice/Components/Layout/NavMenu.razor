@inject NavigationManager NavigationManager

<header class="app-header">
    <i class="fa-solid fa-clapperboard"></i>
    <h1>Movie Events</h1>
    <nav class="header-nav">
        <ul>
            <li><a href="/" class="@(IsActive("/") ? "active" : "")">Plan</a></li>
            <li><a href="/register" class="@(IsActive("/register") ? "active" : "")">Register</a></li>
            <li><a href="/catalog" class="@(IsActive("/catalog") ? "active" : "")">Catalog</a></li>
        </ul>
    </nav>
</header>

@code
{
    private bool IsActive(string href)
    {
        string relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        string current = relativePath.Trim('/').ToLower();
        string target = href.Trim('/').ToLower();

        if (string.IsNullOrEmpty(target))
        {
            return string.IsNullOrWhiteSpace(current);
        }
        
        return current.StartsWith(target);
    }
}