@page "/Register"
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8">
            <EditForm Model="@FormViewModel" 
                      OnValidSubmit="HandleValidSubmit"
                      class="p-4 border rounded shadow-sm bg-light">
            <DataAnnotationsValidator/>

            <div class="row g-3">
                @* Title *@
                <div class="col-md-8">
                    <label for="movieTitle" class="form-label fw-bold">Movie Title</label>
                    <InputText id="movieTitle" @bind-Value="FormViewModel.Title" class="form-control" placeholder="e.g. Inception"/>
                    <ValidationMessage For="@(() => FormViewModel.Title)"/>
                </div>

                @* Release Year *@
                <div class="col-md-4">
                    <label for="releaseYear" class="form-label fw-bold">Release Year</label>
                    <InputNumber id="releaseYear" @bind-Value="FormViewModel.ReleaseYear" class="form-control"/>
                    <ValidationMessage For="@(() => FormViewModel.ReleaseYear)"/>
                </div>

                @* Poster URL *@
                <div class="col-12">
                    <label for="posterUrl" class="form-label fw-bold">Poster URL</label>
                    <InputText id="posterUrl" @bind-Value="FormViewModel.PosterUrl" class="form-control" placeholder="https://..."/>
                    <ValidationMessage For="@(() => FormViewModel.PosterUrl)"/>
                </div>

                @* Description *@
                <div class="col-12">
                    <label for="description" class="form-label fw-bold">Description</label>
                    <InputTextArea id="description" @bind-Value="FormViewModel.Description" class="form-control" rows="4"
                                   placeholder="Enter a brief summary of the movie..."/>
                    <ValidationMessage For="@(() => FormViewModel.Description)"/>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="duration" class="form-label fw-bold">Duration (minutes)</label>
                        <InputNumber id="duration" @bind-Value="FormViewModel.Duration" class="form-control" placeholder="e.g. 120" />
                        <ValidationMessage For="@(() => FormViewModel.Duration)" />
                    </div>

                    <div class="col-md-6">
                        <label for="ageRating" class="form-label fw-bold">Age Rating</label>
                        <InputNumber id="ageRating" @bind-Value="FormViewModel.AgeRating" class="form-control" placeholder="0-18" />
                        <ValidationMessage For="@(() => FormViewModel.AgeRating)" />
                    </div>
                </div>
                
                @* Actors Section *@
                <div class="col-md-6">
                    <label for="actorInput" class="form-label fw-bold">Actors</label>
                    <div class="input-group mb-2">
                        <input type="text"
                               class="form-control"
                               placeholder="Add actor..."
                               @bind="_tempActor"
                               id="actorInput"/>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="TryAddActor">
                            Add
                        </button>
                    </div>
                    <ValidationMessage For="@(() => FormViewModel.Actors)"/>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var actor in FormViewModel.Actors)
                        {
                            <span class="badge rounded-pill bg-dark d-flex align-items-center p-2 text-break text-wrap">
                                @actor
                                <button
                                    type="button"
                                    class="btn-close btn-close-white ms-2"
                                    style="font-size: 0.5rem"
                                    aria-label="Remove"
                                    @onclick="() => FormViewModel.Actors.Remove(actor)"></button>
                            </span>
                        }
                    </div>
                </div>

                @* Genres Section *@
                <div class="col-md-6">
                    <label for="genreInput" class="form-label fw-bold">Genres</label>
                    <div class="input-group mb-2">
                        <input type="text"
                               class="form-control"
                               placeholder="Add genre..."
                               @bind="_tempGenre"
                               id="genreInput"/>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="TryAddGenre">
                            Add
                        </button>
                    </div>
                    <ValidationMessage For="@(() => FormViewModel.Genres)"/>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var genre in FormViewModel.Genres)
                        {
                            <span class="badge rounded-pill bg-primary d-flex align-items-center p-2 text-break text-wrap">
                                @genre
                                <button
                                    type="button"
                                    class="btn-close btn-close-white ms-2"
                                    style="font-size: 0.5rem"
                                    aria-label="Remove"
                                    @onclick="() => FormViewModel.Genres.Remove(genre)"></button>
                            </span>
                        }
                    </div>
                </div>

                @* Submit Button & API Feedback *@
                <div class="col-12 text-end mt-4 border-top pt-3">
                    <div class="d-flex align-items-center justify-content-end gap-3">
        
                        @if (ViewModel.SuccessFullyRegistered.HasValue)
                        {
                            <div class="alert alert-success py-2 px-3 mb-0 d-flex align-items-center shadow-sm" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <div>Movie registered successfully!</div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
                        {
                            <div class="alert alert-danger py-2 px-3 mb-0 d-flex align-items-center shadow-sm" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <div>@ViewModel.ErrorMessage</div>
                            </div>
                        }

                        <button type="submit" class="btn btn-success btn-lg px-5">
                            Register Movie
                        </button>
                    </div>
                </div>
            </div>
        </EditForm>
        </div>
        
        @* Preview Section *@
        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-header bg-dark text-white fw-bold text-center">
                    Poster Preview
                </div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center bg-secondary-subtle" style="min-height: 400px;">
                    @if (!string.IsNullOrWhiteSpace(FormViewModel.PosterUrl))
                    {
                        <img src="@FormViewModel.PosterUrl"
                             alt="Movie Poster Preview"
                             class="img-fluid rounded shadow"
                             style="max-height: 450px; object-fit: contain;"/>
                    }
                    else
                    {
                        <div class="text-muted text-center">
                            <i class="bi bi-image" style="font-size: 3rem;"></i>
                            <p>No URL provided</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

