@page "/Register"
@rendermode InteractiveServer

<main>
    <div class="register-main-row">
        <div class="register-main-col">
            <EditForm OnValidSubmit="HandleValidSubmit"
                      class="register-form-container"
                      EditContext="_editContext">
            <DataAnnotationsValidator/>

            <div class="register-form-row">
                @* Title *@
                <div class="register-col-8">
                    <label for="movieTitle" class="register-form-label">Movie Title</label>
                    <InputText id="movieTitle" @bind-Value="FormViewModel.Title" class="register-form-control" placeholder="e.g. Inception"/>
                    <ValidationMessage For="@(() => FormViewModel.Title)"/>
                </div>

                @* Release Year *@
                <div class="register-col-4">
                    <label for="releaseYear" class="register-form-label">Release Year</label>
                    <InputNumber id="releaseYear" @bind-Value="FormViewModel.ReleaseYear" class="register-form-control"/>
                    <ValidationMessage For="@(() => FormViewModel.ReleaseYear)"/>
                </div>

                @* Poster URL *@
                <div class="register-col-12">
                    <label for="posterUrl" class="register-form-label">Poster URL</label>
                    <InputText id="posterUrl" @bind-Value="FormViewModel.PosterUrl" class="register-form-control" placeholder="https://..."/>
                    <ValidationMessage For="@(() => FormViewModel.PosterUrl)"/>
                </div>

                @* Description *@
                <div class="register-col-12">
                    <label for="description" class="register-form-label">Description</label>
                    <InputTextArea id="description" @bind-Value="FormViewModel.Description" class="register-form-control" rows="4"
                                   placeholder="Enter a brief summary of the movie..."/>
                    <ValidationMessage For="@(() => FormViewModel.Description)"/>
                </div>

                <div class="register-form-row">
                    <div class="register-col-6">
                        <label for="duration" class="register-form-label">Duration (minutes)</label>
                        <InputNumber id="duration" @bind-Value="FormViewModel.Duration" class="register-form-control" placeholder="e.g. 120" />
                        <ValidationMessage For="@(() => FormViewModel.Duration)" />
                    </div>

                    <div class="register-col-6">
                        <label for="ageRating" class="register-form-label">Age Rating</label>
                        <InputNumber id="ageRating" @bind-Value="FormViewModel.AgeRating" class="register-form-control" placeholder="0-18" />
                        <ValidationMessage For="@(() => FormViewModel.AgeRating)" />
                    </div>
                </div>
                
                @* Actors Section *@
                <NonEmptyStringSetInput Label="Actors"
                              InputId="actorInput"
                              Placeholder="Add actor..."
                              Items="@FormViewModel.Actors"
                              For="@(() => FormViewModel.Actors)"
                              BadgeClass="register-badge-dark"/>

                 @* Genres Section *@
                <NonEmptyStringSetInput Label="Genres"
                              InputId="genreInput"
                              Placeholder="Add genre..."
                              Items="@FormViewModel.Genres"
                              For="@(() => FormViewModel.Genres)"
                              BadgeClass="register-badge-primary"/>

                @* Submit Button & API Feedback *@
                <div class="register-col-12 register-actions-container">
                    <div class="register-actions-flex">
        
                        @if (ViewModel.SuccessFullyRegistered.HasValue && ViewModel.SuccessFullyRegistered.Value)
                        {
                            <div class="register-alert register-alert-success" role="alert">
                                Movie registered successfully!
                            </div>
                            
                        }
                        else if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
                        {
                            <div class="register-alert register-alert-danger" role="alert">
                                @ViewModel.ErrorMessage
                            </div>
                        }

                        <button type="button" class="submit-button" @onclick="HandleManualSubmit">
                            Register Movie
                        </button>
                    </div>
                </div>
            </div>
        </EditForm>
        </div>
        
        @* Preview Section *@
        <PosterPreview Url="@FormViewModel.PosterUrl"/>
    </div>
</main>
