@page "/Register"
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8">
            <EditForm OnValidSubmit="HandleValidSubmit"
                      class="p-4 border rounded shadow-sm bg-light"
                      EditContext="_editContext">
            <DataAnnotationsValidator/>

            <div class="row g-3">
                @* Title *@
                <div class="col-md-8">
                    <label for="movieTitle" class="form-label fw-bold">Movie Title</label>
                    <InputText id="movieTitle" @bind-Value="FormViewModel.Title" class="form-control" placeholder="e.g. Inception"/>
                    <ValidationMessage For="@(() => FormViewModel.Title)"/>
                </div>

                @* Release Year *@
                <div class="col-md-4">
                    <label for="releaseYear" class="form-label fw-bold">Release Year</label>
                    <InputNumber id="releaseYear" @bind-Value="FormViewModel.ReleaseYear" class="form-control"/>
                    <ValidationMessage For="@(() => FormViewModel.ReleaseYear)"/>
                </div>

                @* Poster URL *@
                <div class="col-12">
                    <label for="posterUrl" class="form-label fw-bold">Poster URL</label>
                    <InputText id="posterUrl" @bind-Value="FormViewModel.PosterUrl" class="form-control" placeholder="https://..."/>
                    <ValidationMessage For="@(() => FormViewModel.PosterUrl)"/>
                </div>

                @* Description *@
                <div class="col-12">
                    <label for="description" class="form-label fw-bold">Description</label>
                    <InputTextArea id="description" @bind-Value="FormViewModel.Description" class="form-control" rows="4"
                                   placeholder="Enter a brief summary of the movie..."/>
                    <ValidationMessage For="@(() => FormViewModel.Description)"/>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="duration" class="form-label fw-bold">Duration (minutes)</label>
                        <InputNumber id="duration" @bind-Value="FormViewModel.Duration" class="form-control" placeholder="e.g. 120" />
                        <ValidationMessage For="@(() => FormViewModel.Duration)" />
                    </div>

                    <div class="col-md-6">
                        <label for="ageRating" class="form-label fw-bold">Age Rating</label>
                        <InputNumber id="ageRating" @bind-Value="FormViewModel.AgeRating" class="form-control" placeholder="0-18" />
                        <ValidationMessage For="@(() => FormViewModel.AgeRating)" />
                    </div>
                </div>
                
                @* Actors Section *@
                <NonEmptyStringSetInput Label="Actors"
                              InputId="actorInput"
                              Placeholder="Add actor..."
                              Items="@FormViewModel.Actors"
                              For="@(() => FormViewModel.Actors)"
                              BadgeClass="bg-dark"/>

                 @* Genres Section *@
                <NonEmptyStringSetInput Label="Genres"
                              InputId="genreInput"
                              Placeholder="Add genre..."
                              Items="@FormViewModel.Genres"
                              For="@(() => FormViewModel.Genres)"
                              BadgeClass="bg-primary"/>

                @* Submit Button & API Feedback *@
                <div class="col-12 text-end mt-4 border-top pt-3">
                    <div class="d-flex align-items-center justify-content-end gap-3">
        
                        @if (ViewModel.SuccessFullyRegistered.HasValue && ViewModel.SuccessFullyRegistered.Value)
                        {
                            <div class="alert alert-success py-2 px-3 mb-0 d-flex align-items-center shadow-sm" role="alert">
                                Movie registered successfully!
                            </div>
                            
                        }
                        else if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
                        {
                            <div class="alert alert-danger py-2 px-3 mb-0 d-flex align-items-center shadow-sm" role="alert">
                                @ViewModel.ErrorMessage
                            </div>
                        }

                        <button type="button" class="btn btn-success btn-lg px-5" @onclick="HandleManualSubmit">
                            Register Movie
                        </button>
                    </div>
                </div>
            </div>
        </EditForm>
        </div>
        
        @* Preview Section *@
        <PosterPreview Url="@FormViewModel.PosterUrl"/>
    </div>
</div>
